{
  "name": "fictionhub",
  "version": "2.0.12",
  "description": "FictionHub — local movies, TV, anime & manga app",
  "main": "electron-main.js",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0"
  },
  "build": {
    "appId": "com.fictionhub.app",
    "productName": "FictionHub",
    "electronVersion": "31.7.7",
    "npmRebuild": false,
    "files": [
      "**/*",
      "!build${/*}",
      "!electron-builder.yml",
      "!fh-backup.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FictionHub",
        "repo": "FictionHub"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
